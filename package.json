{
  "name": "account-ledger-core",
  "version": "1.0.0",
  "description": "In-memory, append-only, value-dated account ledger core",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "replay": "tsx src/replay.ts",
    "test": "vitest run --exclude 'test/known-failing/**'",
    "test:known-failing": "vitest run test/known-failing",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src test \"*.{ts,js,json}\"",
    "format:check": "prettier --check src test \"*.{ts,js,json}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
